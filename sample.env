# JWT authentication for authenticate-profile endpoint
# JWT_SOURCE: 'cookie' (default) or 'header'
JWT_SOURCE='cookie'
# Key name for cookie-based retrieval (used when JWT_SOURCE=cookie)
JWT_COOKIE_KEY=''
# Header name for header-based retrieval (used when JWT_SOURCE=header, e.g. 'Authorization')
JWT_HEADER_KEY='Authorization'
JWT_TOKEN_SECRET=''
# Field inside the JWT payload's 'data' object that holds the unique identifier (e.g. userId, username)
JWT_IDENTIFIER_FIELD='userId'
# Suffix appended to the identifier to form the profile email. Leave blank if identifier is already a full email.
JWT_EMAIL_SUFFIX='@shikshalokam.org'
SSO_REROUTE_URL=''

# Redis host used by the application and Celery workers.
REDIS_HOST=127.0.0.1

# Port on which the Redis server is listening.
REDIS_PORT=6379

# Enable SSL/TLS when connecting to Redis (set to true for secure remote Redis instances).
REDIS_USE_SSL=false

# Redis logical database dedicated to Celery to isolate task queues from other application data.
REDIS_CELERY_DB=2

# Default Celery queue name used for publishing and consuming asynchronous tasks.
CELERY_TASK_DEFAULT_QUEUE=mitra_queue

## Mitra loging directory config by default it's `CODE_BASE_DIR + '/logs'`
LOGGING_DIR=